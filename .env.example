# URL pública del sitio (para Open Graph en producción)
NEXT_PUBLIC_SITE_URL=https://puntual.app

# Formspree — formulario de "Solicitar demo"
# 1. Creá cuenta en https://formspree.io (plan gratis: 50 envíos/mes)
# 2. New Form → pegá tu email donde querés recibir las demos
# 3. Copiá el endpoint (https://formspree.io/f/xxxxx) acá y en .env.local
# 4. En Formspree → Form Settings → activá spam filtering (Formshield)
# 5. Reiniciá `pnpm dev` / redeploy en Vercel con la misma variable
NEXT_PUBLIC_CONTACT_FORM_ENDPOINT=https://formspree.io/f/xxxxx

# WhatsApp — CTAs de planes en /#precios (solo dígitos, ej. 5491112345678)
NEXT_PUBLIC_WHATSAPP_NUMBER=5492923537308
